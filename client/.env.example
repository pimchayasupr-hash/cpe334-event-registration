# Frontend configuration (leave empty to use relative /api proxy)
VITE_API_URL=

# Quick Demo sign-in (Vite dev server only: `npm run dev`).
# Copy to client/.env.local (gitignored) and set the SAME values you used for
# SEED_ORGANIZER_PASSWORD / SEED_PARTICIPANT_PASSWORD in your local .env.
# Leave empty to hide the Quick Demo buttons. Never set these for production
# builds; the Dockerfile does not pass them and `import.meta.env.DEV` is false.
VITE_DEMO_ORGANIZER_EMAIL=organizer@kmutt.ac.th
VITE_DEMO_ORGANIZER_PASSWORD=
VITE_DEMO_PARTICIPANT_EMAIL=participant@kmutt.ac.th
VITE_DEMO_PARTICIPANT_PASSWORD=
